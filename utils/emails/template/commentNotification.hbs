<!-- implementacion de luis llanos (plantilla de correo para notificacion de comentarios en pedagogias) -->
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <title>Nuevo Comentario en Planeación Pedagógica</title>
  <style>
    body {
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1.6;
      color: #333333;
      background-color: #f4f6f8;
      margin: 0;
      padding: 20px 0;
    }
    .container {
      max-width: 650px;
      margin: 0 auto;
      background-color: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }
    .header {
      background-color: #008f39;
      color: #ffffff;
      padding: 20px;
      text-align: center;
    }
    .header h1 {
      margin: 0;
      font-size: 20px;
      letter-spacing: 0.5px;
      font-weight: bold;
    }
    .header p {
      margin: 5px 0 0 0;
      font-size: 13px;
      color: #e8f5e9;
    }
    .content {
      padding: 25px 30px;
    }
    .greeting {
      font-size: 16px;
      margin-bottom: 15px;
    }
    .info-table {
      width: 100%;
      border-collapse: collapse;
      margin: 20px 0;
      font-size: 14px;
      background-color: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 6px;
    }
    .info-table td {
      padding: 10px 14px;
      border-bottom: 1px solid #e2e8f0;
      vertical-align: top;
    }
    .info-table tr:last-child td {
      border-bottom: none;
    }
    .info-label {
      width: 150px;
      font-weight: bold;
      color: #1b5e20;
    }
    .info-val {
      color: #2d3748;
    }
    .comment-box {
      background-color: #f0fdf4;
      border-left: 4px solid #008f39;
      padding: 16px 20px;
      margin: 20px 0;
      border-radius: 0 6px 6px 0;
    }
    .comment-header {
      font-size: 13px;
      font-weight: bold;
      color: #1b5e20;
      margin-bottom: 8px;
    }
    .comment-body {
      font-size: 15px;
      color: #1f2937;
      white-space: pre-wrap;
      font-style: italic;
    }
    .btn-container {
      text-align: center;
      margin: 30px 0 15px 0;
    }
    .btn {
      display: inline-block;
      background-color: #008f39;
      color: #ffffff !important;
      text-decoration: none;
      padding: 12px 26px;
      font-weight: bold;
      border-radius: 5px;
      font-size: 14px;
      letter-spacing: 0.5px;
    }
    .footer {
      font-size: 12px;
      color: #718096;
      text-align: center;
      padding: 18px 20px;
      background-color: #f8fafc;
      border-top: 1px solid #edf2f7;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>REPFORA — PLANEACIÓN PEDAGÓGICA</h1>
      <p>Notificación de Retroalimentación / Comentario en Actividad</p>
    </div>

    <div class="content">
      <div class="greeting">
        Cordial saludo, <strong>{{recipientName}}</strong>.
      </div>
      <p>
        Se ha registrado una nueva observación / comentario en el <strong>Módulo de Pedagogías</strong> correspondiente a la siguiente ficha y actividad formativa:
      </p>

      <table class="info-table">
        <tr>
          <td class="info-label">Ficha:</td>
          <td class="info-val"><strong>{{fiche}}</strong></td>
        </tr>
        <tr>
          <td class="info-label">Programa:</td>
          <td class="info-val">{{programName}}</td>
        </tr>
        <tr>
          <td class="info-label">Fase:</td>
          <td class="info-val">{{phase}}</td>
        </tr>
        <tr>
          <td class="info-label">Competencia:</td>
          <td class="info-val"><strong>{{competenceCode}}</strong> — {{competenceName}}</td>
        </tr>
        <tr>
          <td class="info-label">Resultado (RAP):</td>
          <td class="info-val">{{rapDescription}}</td>
        </tr>
        <tr>
          <td class="info-label">Actividad:</td>
          <td class="info-val">{{activityDescription}}</td>
        </tr>
        <tr>
          <td class="info-label">Profesor Titular:</td>
          <td class="info-val"><strong>{{instructorName}}</strong></td>
        </tr>
      </table>

      <div class="comment-box">
        <div class="comment-header">
          Comentario emitido por {{authorName}} ({{authorRole}}) el {{date}}:
        </div>
        <div class="comment-body">"{{commentText}}"</div>
      </div>

      <div class="btn-container">
        <a href="{{url}}" class="btn" target="_blank">Ingresar a REPFORA</a>
      </div>
    </div>

    <div class="footer">
      Este es un mensaje generado automáticamente por el sistema REPFORA.<br>
      Por favor no responda a este correo electrónico.
    </div>
  </div>
</body>
</html>
<!-- fin de implementacion luis llanos -->
